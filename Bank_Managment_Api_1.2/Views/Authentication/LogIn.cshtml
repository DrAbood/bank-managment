
@{
    ViewData["Title"]= "LogIn Page";
}
<!DOCTPE html>
<html>
    <head>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

        @* <style>
            body{
                background-color: lightblue;
                text-align:center;
            }
            .NameInput 
            {
                margin-top: 50
            }
        </style> *@
            <link rel="stylesheet" type= "text/css" href="/css/Authentication/Auth.css">

        <script src='/js/Auth/Login.js' defer></script>
    </head>
    @* Styled by DeepSeek *@
    <body>
  <div class="form-container">
    <div class="form-header">
      <h1>Welcome Back</h1>
      <p>Sign in to your account</p>
    </div>
    
    <form id="loginForm">
      <div class="form-layout">
        <div class="form-group">
          <label for="Name">UserName</label>
          <input type="text" id="Name" name="Name" required placeholder="Enter UserName">
        </div>
        
        <div class="form-group">
          <label for="password">Password:</label>
          <input type="password" id="password" name="password" required placeholder="Enter Password">
        </div>
      
        
        <div class="form-group">
          <button class="submit-btn" type="submit" id="submit">Login</button>
        </div>
      </div>
    </form>
  </div>
</body>
</html>