@{
    ViewData["Title"]= "Details Page";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Account Details</title>

    <!-- keep your script includes as-is (you may replace the CDN with a local file if you want) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/Account/Details.js" defer></script>

    <!-- local CSS link (place file at /css/details-style.css) -->
    <link rel="stylesheet" href="/css/Account/Details.css" />
</head>
<body>
    <div class="page-wrapper">
      <h1>Account Information</h1>

      <div class="details-card">

        <ul class="details-list"></ul>

        <div class="action-row">
          <!-- keep onclick handlers unchanged -->
          <button class="edit-btn" onclick="EditAccount()" >Edit Account</button>
          <button class="delete-btn" onclick="DeleteAccount()" method='Delete'>Delete Account</button>
        </div>
      </div>
    </div>
</body>
</html>
